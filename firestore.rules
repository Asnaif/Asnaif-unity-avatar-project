rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection - Allow authenticated users, admins can read/write all
    match /users/{userId} {
      // Users can read their own document
      allow read: if request.auth != null && isOwner(userId);
      // Admins can read all user documents
      allow read: if isAdmin();
      // Users can create/update their own document
      allow create, update: if request.auth != null && isOwner(userId);
      // Admins can update any user document (for role management)
      allow update: if isAdmin();
      // Users can delete their own document (for account deletion)
      allow delete: if request.auth != null && isOwner(userId);
      // Admins can delete any user document
      allow delete: if isAdmin();
    }
    
    // Sessions collection - Users own, admins can read all
    match /sessions/{userId} {
      // Users can read/write their own sessions
      allow read, write: if request.auth != null && isOwner(userId);
      // Users can delete their own sessions document (for account deletion)
      allow delete: if request.auth != null && isOwner(userId);
      // Admins can read all sessions
      allow read: if isAdmin();
    }
    
    // User Progress - Users can read all for leaderboard, write only their own, admins can read all
    match /userProgress/{userId} {
      // Anyone authenticated can read (for leaderboard)
      allow read: if request.auth != null;
      // Users can write only their own
      allow write: if request.auth != null && isOwner(userId);
      // Admins can also write (for management if needed)
      allow write: if isAdmin();
    }
    
    // Files are uploaded by one user and possibly read by the backend.
    // Allow authenticated read for everyone, write only if signed in.
    match /files/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Question Audios are also uploaded by the backend.
    // Allow authenticated read for everyone, write only if signed in.
    match /questionAudios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // Admins can also read all
      allow read: if isAdmin();
    }
    
    // Slide Images (for PPTX files) - Added for practice session
    // Allow authenticated users to read/write their own slide images
    match /slideImages/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // Admins can read all
      allow read: if isAdmin();
    }
    
    // User Preferences - Users can manage their own preferences
    match /userPreferences/{userId} {
      allow read, write, delete: if request.auth != null && isOwner(userId);
      // Admins can read all preferences
      allow read: if isAdmin();
    }
    
    // Goals collection - Users can manage their own goals
    match /goals/{goalId} {
      // Users can read/write goals where they are the owner
      allow read, write, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Users can create goals with themselves as owner
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      // Admins can read all goals
      allow read: if isAdmin();
    }
    
    // Activity Logs collection - User activity monitoring and logging
    match /activityLogs/{logId} {
      // Users can read their own activity logs
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      // Admins can read all activity logs (for monitoring)
      allow read: if isAdmin();
      // Users can create activity logs (validated to be for themselves by service)
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      // Only admins can update or delete activity logs
      allow update, delete: if isAdmin();
    }
    
  }
}

